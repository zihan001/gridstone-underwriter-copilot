# Optional. Enables LLM-generated memo prose (rejection rationale, narrative,
# exception summaries). WITHOUT it the pipeline still runs and the memo renders
# with deterministic template prose — numbers are identical either way (the LLM
# never produces a number that enters the underwriting result; see ARCHITECTURE.md).
ANTHROPIC_API_KEY=

# Model for the single batched prose call. Defaults in code if unset.
KVCOMP_LLM_MODEL=claude-sonnet-4-20250514
